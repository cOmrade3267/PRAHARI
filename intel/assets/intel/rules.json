  "c2Patterns": [
    { "id": "c2.ip_literal",     "label": "Hardcoded IP endpoint",             "regex": "https?://\\d{1,3}(?:\\.\\d{1,3}){3}",                 "weight": 12, "heuristic": true },
    { "id": "c2.high_port",      "label": "URL with non-standard high port",   "regex": "https?://[A-Za-z0-9.\\-]+:(?:[2-9][0-9]{3,4})",       "weight": 8,  "heuristic": true },
    { "id": "c2.suspicious_tld", "label": "Suspicious free/abused TLD host",   "regex": "https?://[A-Za-z0-9.\\-]+\\.(?:top|xyz|tk|gq|cf|ml|ga|su|cc|pw|icu|rest|click)(?:[/:?#]|$)", "weight": 8, "heuristic": true },
    { "id": "c2.telegram_bot",   "label": "Telegram bot API (common C2/exfil)", "regex": "api\\.telegram\\.org/bot",                           "weight": 15, "heuristic": true },
    { "id": "c2.pastebin_raw",   "label": "Pastebin raw (dead-drop config)",    "regex": "(?:pastebin\\.com|rentry\\.co|paste\\.ee)/raw",      "weight": 12, "heuristic": true },
    { "id": "c2.dyn_dns",        "label": "Dynamic-DNS host (duckdns/no-ip/etc.)", "regex": "[A-Za-z0-9.\\-]+\\.(?:duckdns\\.org|no-ip\\.(?:org|com|biz)|hopto\\.org|ddns\\.net)", "weight": 12, "heuristic": true }
  ],

  "comboRules": [
    { "id": "combo.overlay_accessibility", "label": "Screen-overlay + accessibility (UI-hijack / fake-login)", "weight": 25, "family": "generic-banker",
      "allOf": ["cap.accessibility_service", "cap.overlay"] },

    { "id": "combo.full_banker", "label": "Accessibility + SMS + device admin (full banking-trojan kit)", "weight": 30, "family": "banker-rokarolla-style",
      "allOf": ["cap.accessibility_service", "cap.device_admin"], "anyOf": ["cap.sms_read", "cap.sms_send", "perm.READ_SMS", "perm.RECEIVE_SMS"] },

    { "id": "combo.sms_stealer", "label": "Reads SMS + network + survives reboot (OTP stealer)", "weight": 20, "family": "sms-stealer",
      "allOf": ["cap.network", "cap.boot_persistence"], "anyOf": ["cap.sms_read", "perm.READ_SMS", "perm.RECEIVE_SMS"] },

    { "id": "combo.dropper", "label": "Dynamic code loading + installs packages (dropper)", "weight": 20, "family": "dropper",
      "allOf": ["cap.dynamic_code"], "anyOf": ["cap.install_packages", "perm.REQUEST_INSTALL_PACKAGES"] },

    { "id": "combo.admin_abuse", "label": "Device admin on an app that is not a security/MDM tool", "weight": 20, "family": "admin-abuse",
      "allOf": ["cap.device_admin"], "noneOf": ["ctx.category_security"] },

    { "id": "combo.context_mismatch", "label": "Utility app (torch/calc/wallpaper) holding sensitive access", "weight": 20, "family": "context-mismatch",
      "allOf": ["ctx.category_utility"], "anyOf": ["cap.sms_read", "cap.sms_send", "cap.accessibility_service", "cap.contacts", "cap.call_log", "cap.location", "perm.READ_SMS", "perm.READ_CONTACTS", "perm.READ_CALL_LOG"] },

    { "id": "combo.spyware", "label": "Location + mic/camera + network (covert surveillance)", "weight": 18, "family": "spyware",
      "allOf": ["cap.network", "cap.location"], "anyOf": ["cap.mic", "cap.camera", "perm.RECORD_AUDIO", "perm.CAMERA"] },

    { "id": "combo.screen_remote", "label": "Screen capture + accessibility (hidden remote control)", "weight": 22, "family": "remote-control",
      "allOf": ["cap.screen_capture", "cap.accessibility_service"] },

    { "id": "combo.sideloaded_dangerous", "label": "Sideloaded app with dynamic code loading", "weight": 15, "family": "sideload-risk",
