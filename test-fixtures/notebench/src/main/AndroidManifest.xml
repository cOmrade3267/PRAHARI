<?xml version="1.0" encoding="utf-8"?>
<!--
  FIXTURE 4 — "NoteBench"  (expected band: LOW) — the BENIGN CONTROL.
  A real, harmless utility. Only normal/low-risk permissions, and no dangerous API references
  in code. If the auditor flags this High/Critical, it is over-scoring (false positive).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:label="NoteBench"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
